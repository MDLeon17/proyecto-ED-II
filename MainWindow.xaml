<Window x:Class="UfgEnvios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UFG ENVIOS | Simulador de rutas de Quetzaltenango"
        Width="1440" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F6F6"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#91B0B6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BCD0D3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="RouteCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#122D38"/>
            <Setter Property="BorderBrush" Value="#8BA7AB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="AlgorithmOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionCard" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="7" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Ellipse Stroke="#B2CDD0" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="SelectionDot" Width="8" Height="8" Fill="#19B49E"
                                             Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionCard" Property="Background" Value="#1A414B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionCard" Property="Background" Value="#244E55"/>
                                <Setter TargetName="OptionCard" Property="BorderBrush" Value="#3E8888"/>
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionCard" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#19B49E"/>
            <Setter Property="Foreground" Value="#062D32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#45D2BF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#6C9295"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#244650"/>
            <Setter Property="Foreground" Value="#DBEAEB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F3F6F6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="334"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102F39">
            <Grid Margin="22,18,22,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#19B49E" CornerRadius="12" Width="46" Height="46" ToolTip="UFG ENVIOS · paquete en camino">
                            <Canvas Width="46" Height="46">
                                <Path Data="M 11,17 L 23,11 L 35,17 L 35,31 L 23,37 L 11,31 Z"
                                      Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round" Fill="#127F75"/>
                                <Path Data="M 11,17 L 23,23 L 35,17 M 23,23 L 23,37"
                                      Stroke="White" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                <Path Data="M 5,34 C 8,34 10,33 11,31" Stroke="#FFB194" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="32" Width="4" Height="4" Fill="#FFB194"/>
                            </Canvas>
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="UFG ENVIOS" Foreground="White" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="CENTRO DE OPERACIONES" Foreground="#9EB8BE" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#244650" CornerRadius="7" Padding="10,6" Margin="0,16,0,0">
                        <TextBlock Text="SIMULADOR  /  QUETZALTENANGO" Foreground="#8FE3D6" FontWeight="Bold" FontSize="10"/>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NUEVO ENVÍO" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Municipio de origen" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboOrigin" Style="{StaticResource RouteCombo}" SelectionChanged="CboNodes_SelectionChanged"/>
                        <TextBlock Text="Municipio de destino" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="CboDestination" Style="{StaticResource RouteCombo}" SelectionChanged="CboNodes_SelectionChanged"/>
                        <Button x:Name="BtnSwapPoints" Content="⇄  Intercambiar municipios" Style="{StaticResource SecondaryButton}" Click="BtnSwapPoints_Click" Margin="0,12,0,0"/>

                        <Border Background="#34515A" Height="1" Margin="0,18,0,17"/>
                        <TextBlock Text="MÉTODO DE RECORRIDO" Style="{StaticResource SectionTitle}"/>
                        <RadioButton x:Name="RbBFS" GroupName="RouteAlgorithm" Content="BFS · menos tramos" IsChecked="True" Checked="RouteMode_Checked" Style="{StaticResource AlgorithmOption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <RadioButton x:Name="RbDFS" GroupName="RouteAlgorithm" Content="DFS · profundidad" Checked="RouteMode_Checked" Style="{StaticResource AlgorithmOption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <RadioButton x:Name="RbCompare" GroupName="RouteAlgorithm" Content="Comparar en paralelo" Checked="RouteMode_Checked" Style="{StaticResource AlgorithmOption}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Velocidad de la simulación" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SliderSpeed" Grid.Column="0" Minimum="1" Maximum="4" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSpeedLabel" Grid.Column="1" Text="Normal" Foreground="#8FE3D6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                        </Grid>
                        <Button x:Name="BtnDispatch" Content="TRAZAR Y DESPACHAR" Style="{StaticResource PrimaryButton}" Click="BtnDispatch_Click" Margin="0,14,0,8"/>
                        <Button x:Name="BtnReset" Content="Limpiar recorrido" Style="{StaticResource SecondaryButton}" Click="BtnReset_Click"/>

                        <Border Background="#244650" CornerRadius="10" Padding="14" Margin="0,17,0,0">
                            <StackPanel>
                                <TextBlock Text="COMPARATIVA" Foreground="#90ABB0" FontSize="10" FontWeight="Bold" Margin="0,0,0,11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="BFS" Foreground="#61D9C6" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtBfsHops" Text="— tramos" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtBfsDist" Text="— km" Foreground="#B5C9CD" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DFS" Foreground="#FFAD91" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtDfsHops" Text="— tramos" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtDfsDist" Text="— km" Foreground="#B5C9CD" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TxtWinnerBadge" Text="Elige municipios y traza una ruta" Foreground="#8FE3D6" FontWeight="SemiBold" Margin="0,13,0,5" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtViabilityExplanation" Text="Aquí aparecerá el análisis de la ruta." Foreground="#C4D4D6" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="UFG ENVIOS  •  PROYECTO ED II" Foreground="#75969C" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="27,22,27,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="174"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Planificador de rutas" Foreground="{StaticResource Ink}" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="Red de entrega entre los 24 municipios de Quetzaltenango" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="GUÍA SIMULADA" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtTrackingNumber" Text="UFG-0000-0000-GT" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold"/>
                        <Button x:Name="BtnRegenerateTracking" Content="↻" Click="BtnRegenerateTracking_Click" ToolTip="Nueva guía" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Teal}" FontSize="18" Cursor="Hand" Margin="8,-4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20,16,20,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MAPA OPERATIVO" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Selecciona municipios en el mapa o en el panel de despacho" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E8F7F3" CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSystemStatus" Text="LISTO PARA DESPACHO" Foreground="#087F72" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Background="#F7F9F6" ClipToBounds="True">
                        <Grid x:Name="SingleMapHost">
                            <Viewbox Stretch="Uniform" StretchDirection="Both">
                                <Canvas x:Name="SingleMapCanvas" Width="775" Height="780" ClipToBounds="True" Background="White" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"/>
                            </Viewbox>
                        </Grid>
                        <Grid x:Name="CompareMapsHost" Visibility="Collapsed" Margin="10,0,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" BorderBrush="#CBE8E2" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="#E8F7F3" Margin="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="BFS" Foreground="#087F72" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="13,0,10,0"/>
                                        <TextBlock x:Name="TxtBfsMapStatus" Grid.Column="1" Text="Esperando ruta" Foreground="#47736E" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                                    </Grid>
                                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                                        <Canvas x:Name="BfsMapCanvas" Width="775" Height="780" ClipToBounds="True" Background="White" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"/>
                                    </Viewbox>
                                    <Grid Grid.Row="2" Margin="13,7,13,8">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtBfsMapDetail" Text="Menor número de tramos" Foreground="#58767A" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="BfsProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Foreground="#19B49E" Background="#D9ECE8" BorderThickness="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="White" BorderBrush="#F6D9CF" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Background="#FFF0EA">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="DFS" Foreground="#D5684D" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="13,0,10,0"/>
                                        <TextBlock x:Name="TxtDfsMapStatus" Grid.Column="1" Text="Esperando ruta" Foreground="#94766C" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,13,0"/>
                                    </Grid>
                                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both">
                                        <Canvas x:Name="DfsMapCanvas" Width="775" Height="780" ClipToBounds="True" Background="White" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"/>
                                    </Viewbox>
                                    <Grid Grid.Row="2" Margin="13,7,13,8">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtDfsMapDetail" Text="Exploración en profundidad" Foreground="#887269" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar x:Name="DfsProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Foreground="#F27A5E" Background="#F8E1D8" BorderThickness="0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Background="#F8FAFA" Margin="0" Height="52">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Ellipse Width="9" Height="9" Fill="#2A75B5" Margin="0,0,7,0"/>
                            <TextBlock Text="Origen" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,15,0"/>
                            <Ellipse Width="9" Height="9" Fill="#A060BB" Margin="0,0,7,0"/>
                            <TextBlock Text="Destino" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,15,0"/>
                            <Ellipse Width="9" Height="9" Fill="#19B49E" Margin="0,0,7,0"/>
                            <TextBlock Text="BFS" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,15,0"/>
                            <Ellipse Width="9" Height="9" Fill="#F27A5E" Margin="0,0,7,0"/>
                            <TextBlock Text="DFS" Foreground="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Distancias y tiempos estimados" Foreground="#92A4A8" FontSize="10" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Seguimiento del envío" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="TxtEventsCount" Grid.Column="1" Text="0 eventos" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </Grid>
                    <ScrollViewer x:Name="ScrollTrackingLogs" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListTrackingLogs">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="#F5F8F8" CornerRadius="6" Padding="8,4" Margin="0,0,0,4"><TextBlock Text="{Binding}" Foreground="#31515B" FontSize="11" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
