<Window x:Class="UfgEnvios.GraphEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar grafos | UFG ENVIOS" Width="1280" Height="880" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#F3F6F6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#47736E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#244650"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F3F6F6">
      <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Editar grafos" FontSize="28" FontWeight="Bold" Foreground="#122D38"/>
            <TextBlock Text="Haz clic en dos municipios del mapa para crear una conexión. Selecciona una línea o una fila para editarla."
                       Margin="0,5,0,0" Foreground="#6D8189" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE6E8" BorderThickness="1" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="TxtEditorMode" Text="NUEVA CONEXIÓN" FontWeight="Bold" Foreground="#087F72"/>
                        <TextBlock Text="Origen (primer clic)" Style="{StaticResource EditorLabel}"/>
                        <TextBlock x:Name="TxtEdgeOrigin" Text="Selecciona un municipio en el mapa" TextWrapping="Wrap"/>
                        <TextBlock Text="Destino (segundo clic)" Style="{StaticResource EditorLabel}"/>
                        <TextBlock x:Name="TxtEdgeDestination" Text="Selecciona otro municipio" TextWrapping="Wrap"/>
                        <TextBlock Text="Sentido de la conexión" Style="{StaticResource EditorLabel}"/>
                        <RadioButton x:Name="RbEdgeOneWay" Content="Unidireccional: origen → destino" GroupName="EdgeDirection" Margin="0,2,0,8"/>
                        <RadioButton x:Name="RbEdgeTwoWay" Content="Bidireccional: origen ↔ destino" GroupName="EdgeDirection" IsChecked="True"/>
                        <TextBlock Text="Distancia simulada (km)" Style="{StaticResource EditorLabel}"/>
                        <TextBox x:Name="TxtEdgeDistance" Text="10" ToolTip="Distancia no negativa. Acepta punto o coma decimal."/>
                        <TextBlock x:Name="TxtEdgeWeights" Text="El costo y el tiempo se estiman a partir de la distancia." Foreground="#6D8189"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button x:Name="BtnSaveEdge" Content="Agregar conexión" Style="{StaticResource EditorButton}"
                                Background="#087F72" IsEnabled="False" Click="SaveEdge_Click"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="BtnNewEdge" Content="Nueva conexión" Style="{StaticResource EditorButton}" Click="NewEdge_Click"/>
                            <Button x:Name="BtnDeleteEdge" Grid.Column="2" Content="Eliminar" Style="{StaticResource EditorButton}"
                                    Background="#A33727" IsEnabled="False" Click="DeleteEdge_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtEdgeFeedback" Text="Selecciona el municipio de origen." TextWrapping="Wrap"
                                   Foreground="#087F72" Margin="0,12,0,0" MinHeight="34" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="TxtRouteCount" Style="{StaticResource EditorLabel}"/>
                        <ListBox x:Name="ListEdges" Height="190" SelectionChanged="ListEdges_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Details}" Foreground="#6D8189" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Los cambios duran durante esta sesión. Al reiniciar se carga el JSON inicial."
                                   Foreground="#6D8189" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DCE6E8" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="MAPA DE CONEXIONES" Foreground="#087F72" FontWeight="Bold" Margin="8,4,0,8"/>
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas x:Name="EditorMapCanvas" Width="775" Height="780" Background="White" ClipToBounds="True"
                                MouseLeftButtonDown="EditorMap_MouseLeftButtonDown"/>
                    </Viewbox>
                    <TextBlock Grid.Row="2" Text="Azul: origen · Morado: destino · Verde: conexión seleccionada · Flechas: sentidos permitidos"
                               Foreground="#6D8189" FontSize="11" TextWrapping="Wrap" Margin="8,10,8,4"/>
                </Grid>
            </Border>
        </Grid>
      </Grid>
    </Grid>
</Window>
